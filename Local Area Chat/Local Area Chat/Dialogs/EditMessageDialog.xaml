<Window x:Class="Local_Area_Chat.Dialogs.EditMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nachricht bearbeiten" Height="180" Width="350">
    <StackPanel Margin="10">
        <TextBox x:Name="ContentTextBox" Text="{Binding OldContent}" Margin="0,0,0,10"/>
        <Button Content="OK" Width="80" HorizontalAlignment="Right" Click="OkButton_Click"/>
    </StackPanel>
</Window>
