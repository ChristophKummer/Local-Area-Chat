<Window x:Class="Local_Area_Chat.Dialogs.ChatManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat verwalten" Height="320" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Chat verwalten:" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
        
        <!-- Chat Settings Section -->
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Chat Name -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Chat-Name ändern:" Margin="0,0,10,5"/>
            <TextBox x:Name="ChatNameTextBox" Grid.Row="1" Grid.Column="0" Height="25" Margin="0,0,10,15"/>
            
            <!-- Status -->
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Status:" Margin="10,0,0,5"/>
            <ComboBox x:Name="StatusComboBox" Grid.Row="1" Grid.Column="1" Height="25" Margin="10,0,0,15">
                <ComboBoxItem Content="Privat" IsSelected="True"/>
                <ComboBoxItem Content="Oeffentlich"/>
            </ComboBox>
        </Grid>
        
        <!-- Participants Section -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Current Participants -->
            <TextBlock Grid.Column="0" Text="Chatteilnehmer:" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="Benutzer hinzufügen:" Margin="10,0,0,0"/>
        </Grid>
        
        <!-- Lists Section -->
        <Grid Grid.Row="3" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Current Participants List -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,10,0">
                <ListBox x:Name="ParticipantsListBox" Background="White" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="- " Foreground="#666"/>
                                <TextBlock Text="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            
            <!-- Available Users List -->
            <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="10,0,0,0">
                <ListBox x:Name="AvailableUsersListBox" Background="White" BorderThickness="0"
                         SelectionChanged="AvailableUsersListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding UserName}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
        
        <!-- Button Panel -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddUserButton" Content="Hinzufügen" Width="80" Height="25" 
                    Margin="0,0,10,0" Click="AddUserButton_Click" IsEnabled="False"/>
            <Button x:Name="RemoveUserButton" Content="Entfernen" Width="80" Height="25" 
                    Margin="0,0,20,0" Click="RemoveUserButton_Click" IsEnabled="False"/>
            <Button x:Name="OkButton" Content="OK" Width="75" Height="25" 
                    Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Abbrechen" Width="75" Height="25" 
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>