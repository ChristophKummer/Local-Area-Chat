<Window x:Class="Local_Area_Chat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Area Chat" Height="350" Width="500" MinHeight="250" MinWidth="320" Background="#545454">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <!-- Menüleiste mit Hamburger-Menü und Login-Button -->
        <Grid Height="30" VerticalAlignment="Top" Background="#545454" Grid.Row="0">
            <!-- Hamburger-Menü links -->
            <Button x:Name="HamburgerButton"
                    Width="20"
                    Height="20"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="HamburgerButton_Click"
                    Background="#545454">
                <StackPanel Orientation="Vertical" Width="18" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Height="2" Width="Auto" Fill="White" Margin="0,1.2"/>
                    <Rectangle Height="2" Width="Auto" Fill="White" Margin="0,1.2"/>
                    <Rectangle Height="2" Width="Auto" Fill="White" Margin="0,1.2"/>
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu x:Name="HamburgerMenu">
                        <MenuItem Header="Einstellungen"/>
                        <MenuItem Header="Profil" Click="HamburgerMenu_Profile_Click"/>
                        <MenuItem Header="Abmelden" Click="HamburgerMenu_Logout_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- Login-Button rechts -->
            <Button x:Name="LoginToggleButton"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Right"
                    Margin="0,5,10,5"
                    Click="LoginToggleButton_Click"
                    Background="#545454">                
                <Viewbox Stretch="Uniform">
                    <Canvas Width="40" Height="40">
                        <Path Stroke="White" StrokeThickness="2" Fill="Transparent" Stretch="Fill"
                              Data="M24,4 C29.5228,4 34,8.4772 34,14 C34,19.5228 29.5228,24 24,24 C18.4772,24 14,19.5228 14,14 C14,8.4772 18.4772,4 24,4 Z M8,44 C8,35.1634 15.1634,28 24,28 C32.8366,28 40,35.1634 40,44" HorizontalAlignment="Left" Canvas.Left="3" VerticalAlignment="Center"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>

        <!-- Login-Popup -->
        <Popup x:Name="LoginPopup"
               Placement="Top"
               PlacementTarget="{Binding ElementName=LoginToggleButton}"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide">
            <Border Background="#ececec" Padding="20" CornerRadius="8"
                    MouseEnter="LoginPopup_MouseEnter"
                    MouseLeave="LoginPopup_MouseLeave">
                <StackPanel>
                    <TextBlock Text="Anmelden" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="User" Margin="0,0,0,5"/>
                    <TextBox x:Name="UserTextBox" Width="180" Margin="0,0,0,10"/>
                    <TextBlock Text="Passwort" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Width="180" Margin="0,0,0,10"/>
                    <TextBlock Text="Public Key" Margin="0,0,0,5"/>
                    <TextBox x:Name="PublicKeyTextBox" Width="180" Margin="0,0,0,10"/>
                    
                    <Button Content="Anmelden" Width="80" Click="LoginButton_Click" Margin="0,0,0,10"/>
                    
                    <Separator Margin="0,10"/>
                    
                    <TextBlock Text="Noch kein Account?" HorizontalAlignment="Center" 
                               FontSize="11" Foreground="#666" Margin="0,5,0,5"/>
                    <Button Content="Neuen Benutzer erstellen" Width="150" Click="RegisterButton_Click"
                            Background="#4CAF50" Foreground="White"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Profil-Bereich (standardmäßig verborgen) -->
        <Border x:Name="ProfilePanel" Visibility="Hidden" Background="#ececec" Margin="60,60,60,60" Panel.ZIndex="100">
            <StackPanel Margin="20">
                <TextBlock Text="User" Margin="0,0,0,5"/>
                <TextBox x:Name="ProfileUserTextBox" Width="180" Margin="0,0,0,10"/>
                <TextBlock Text="Passwort" Margin="0,0,0,5"/>
                <TextBox x:Name="ProfilePasswordTextBox" Width="180" Margin="0,0,0,10"/>
                <TextBlock Text="Public Key" Margin="0,0,0,5"/>
                <TextBox x:Name="ProfilePublicKeyTextBox" Width="180" Margin="0,0,0,10"/>
                <TextBlock Text="Benutzerrolle" Margin="0,0,0,5"/>
                <ComboBox x:Name="ProfileRoleComboBox" Width="180" Margin="0,0,0,10">
                    <ComboBoxItem Content="Admin"/>
                    <ComboBoxItem Content="Editor"/>
                </ComboBox>
                <Button Content="Speichern" Width="80" Click="ProfileSaveButton_Click"/>
                <Button Content="Schließen" Width="80" Margin="10,0,0,0" Click="ProfileCloseButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Hauptinhalt -->
        <Grid Margin="10,00,10,10" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MaxWidth="200" MinWidth="100"/>
                <ColumnDefinition Width="2*" MinWidth="100"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SelectedChatroomTextBlock" Text="Chats:" Foreground="White"
                       FontSize="10" Grid.Column="1" Grid.Row="0"/>
            <TextBlock Text="Chats:" Foreground="White" FontSize="10" Padding="0,1" Grid.Column="0" Grid.Row="0"/>

            <!-- Chatroom-Auswahl -->
            <ListBox x:Name="ChatroomListBox"
                     Grid.Column="0"
                     Grid.Row="1"
                     Margin="0,0,10,10"
                     SelectionChanged="ChatroomListBox_SelectionChanged"
                     Background="#ececec"/>

            <!-- Nachrichtenanzeige -->
            <ListBox x:Name="MessagesListBox"
                     Grid.Column="1"
                     Grid.Row="1"
                     Margin="0,0,0,10"
                     Background="#ececec">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Bearbeiten" Click="EditMessage_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- Nachrichteneingabe und Senden -->
            <Grid Grid.Column="1" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80" MinWidth="80"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="MessageTextBox" HorizontalAlignment="Stretch" Margin="0,0,10,0"
                         KeyDown="MessageTextBox_KeyDown" />
                <Button Grid.Column="1" Content="Senden" Width="80" Click="SendButton_Click"/>            
            </Grid>
        </Grid>
    </Grid>
</Window>

































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































