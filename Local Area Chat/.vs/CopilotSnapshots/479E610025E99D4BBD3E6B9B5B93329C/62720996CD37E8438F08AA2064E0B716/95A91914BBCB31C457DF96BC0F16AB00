        // Alle Daten löschen (für Neuerstellung)
        public async Task ClearAllDataAsync()
        {
            await _chats.DeleteManyAsync(_ => true);
            await _messages.DeleteManyAsync(_ => true);
            await _users.DeleteManyAsync(_ => true);
        }
    }
}