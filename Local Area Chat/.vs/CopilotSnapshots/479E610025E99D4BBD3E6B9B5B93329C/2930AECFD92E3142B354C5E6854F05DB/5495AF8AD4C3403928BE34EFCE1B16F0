<Window x:Class="Local_Area_Chat.Dialogs.RegisterUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neuen Benutzer erstellen" Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Neuen Benutzer registrieren" 
                   FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>
        
        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Benutzername:" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameTextBox" Height="30" Padding="5" Margin="0,0,0,10"/>
            
            <TextBlock Text="Passwort:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="30" Padding="5" Margin="0,0,0,10"/>
            
            <TextBlock Text="Passwort bestätigen:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="30" Padding="5" Margin="0,0,0,10"/>
            
            <TextBlock Text="Public Key (optional):" Margin="0,0,0,5"/>
            <TextBox x:Name="PublicKeyTextBox" Height="30" Padding="5" 
                     ToolTip="Leer lassen für automatische Generierung" Margin="0,0,0,10"/>
            
            <!-- Info -->
            <Border Background="#f0f0f0" Padding="10" Margin="0,10,0,0" CornerRadius="5">
                <TextBlock Text="Hinweis: Der Benutzername muss eindeutig sein und kann nach der Erstellung nicht mehr geändert werden."
                           TextWrapping="Wrap" FontSize="11" Foreground="#666"/>
            </Border>
        </StackPanel>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Abbrechen" Width="80" Height="30" 
                    Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Registrieren" Width="80" Height="30" 
                    Click="RegisterButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>